{
  "name": "opencode-plugin-salesforce-cli",
  "version": "0.1.0",
  "description": "Plugin OpenCode/Orca para conectar em orgs Salesforce e executar Apex anônimo via Salesforce CLI.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "opencode",
    "orca",
    "plugin",
    "salesforce",
    "sf"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
